{
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    // Must be set explicitly. Without it TypeScript infers the common source directory,
    // and that inference changed in newer releases: declarations started landing at
    // dist-js/guest-js/index.d.ts while package.json "types" points at
    // dist-js/index.d.ts. That shipped in 0.1.0-beta.7 with no type definitions
    // resolvable at all. Pinning rootDir keeps the emit path stable.
    "rootDir": "./guest-js",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "noEmit": true
  },
  "include": ["guest-js/*.ts"],
  "exclude": ["dist-js", "node_modules"]
}
